# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

BOSDYN_CLIENT_USERNAME=your_username
BOSDYN_CLIENT_PASSWORD=your_password
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
SPOT_HOSTNAME=192.168.80.3
SPOT_AUTO_CONNECT=true
TELEGRAM_RBAC_ENABLED=true
TELEGRAM_RBAC_CONFIG_PATH=config/telegram_rbac.yml
RECORD_BACKEND_DEFAULT=hybrid
RECORD_WEBRTC_SDP_PORT=31102
RECORD_WEBRTC_SDP_FILENAME=h264.sdp
RECORD_WEBRTC_VERIFY_TLS=false
RECORD_WEBRTC_CA_CERT_PATH=
RECORD_WEBRTC_CONNECT_TIMEOUT_SECONDS=10
RECORD_WEBRTC_ICE_TIMEOUT_SECONDS=15
